# PostgreSQL do Railway (use a URL de conexão privada do serviço PostgreSQL)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/railway?schema=public"

# Segredo novo, aleatório e exclusivo para produção (não reutilize o segredo antigo)
JWT_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO"
JWT_EXPIRES_IN="7d"

NODE_ENV="production"
PORT="3333"
FRONTEND_URL="https://SEU-DOMINIO.up.railway.app"

# SMTP é opcional; configure somente se o sistema for enviar convites por e-mail
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
