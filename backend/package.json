{
  "name": "cmto-vi-backend",
  "version": "1.0.0",
  "description": "Backend do Sistema de Gestão Disciplinar - CMTO VI",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node src/seed/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:generate:sqlite-source": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:prepare-migration": "node scripts/create-initial-migration.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:copy": "node scripts/migrate-sqlite-to-postgres.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.15.1",
    "pm2": "^7.0.1",
    "prisma": "^5.22.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
